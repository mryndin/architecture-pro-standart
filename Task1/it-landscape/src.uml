@startuml
!theme spacelab
skinparam componentStyle rectangle
skinparam packageStyle frame

title Карта IT-ландшафта и интеграций банка «Стандарт» (As-Is)

package "Фронт-офис и Каналы" {
    [Сайт (PHP/React)] as Site <<Web>>
    [Интернет-банк (ASP.NET)] as IB <<Monolith>>
    [Рабочее место сотрудника (Delphi)] as Branch <<Desktop>>
    [Система кол-центра (React/Java)] as CC <<Microservices>>
}

package "Бэк-офис и Ядро" {
    database "Oracle (АБС)" as ABS_DB {
        [Процедуры PL/SQL]
    }
    [АБС (Delphi/Oracle)] as ABS <<Core>>
    [Excel (Расчет ставок)] as Excel <<Manual>>
}

package "Кредитный конвейер" {
    [Camunda BPM] as Camunda <<BPM>>
    [Scoring Service (Python)] as Scoring <<ML>>
}

package "Внешние системы / Подрядчики" {
    [БКИ] as BKI <<External API>>
    [СМС-шлюз] as SMS <<External>>
    [Партнерский КЦ] as PCC <<External>>
}

' --- ИНТЕГРАЦИИ ДЕПОЗИТНОГО ПРОЦЕССА ---
IB -[#red]- ABS_DB : "Прямое чтение/запись БД (Anti-pattern)"
Branch --> ABS : "Оформление заявок"
CC --> ABS : "Передача обращений"
Excel .[#blue].> ABS : "Ручной ввод ставок (после почты)"
Excel .[#blue].> Branch : "Ставки по почте"
ABS --> SMS : "Оповещение о ставке"

' --- ИНТЕГРАЦИИ КРЕДИТНОГО ПРОЦЕССА ---
ABS -[#orange]- Camunda : "Batch-обмен (раз в сутки)"
Camunda <--> Scoring : "REST API"
Scoring <--> BKI : "REST API"
ABS -[#orange]-> Scoring : "Данные о платежах (раз в сутки)"

' --- ЛЕГЕНДА ---
legend right
  | Цвет | Тип связи |
  | <#red> | Прямой доступ к БД (Legacy) |
  | <#orange> | Пакетная передача (Задержка 24ч) |
  | <#blue> | Ручной процесс (Email/Excel) |
endlegend

@enduml